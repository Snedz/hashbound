# Copy to .env on the deployment host ONLY. Never commit a filled .env.
# The Serverless Inference key is separate from the Vultr account API key.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# Pin the model from the live catalog (GET /v1/models) at deploy time:
VULTR_INFERENCE_MODEL=
PORT=8080
